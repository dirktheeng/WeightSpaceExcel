# eval/rc_back (id 93): back edge to a visiting cell P. PC 0: x0 = its stack index; LOW = min(LOW,
# x0), CYC = 1; CIRCV == 0: read KEY at P -> PC 1; else -> rc_loop. PC 1: CIRCV = x0 -> rc_loop.
input 65
slice 0 8 9                       # v1 PC
slice 0 63 64                     # v2 CIRCV
slice 0 0 1                       # v3 x0
slice 0 62 63                     # v4 LOW
slice 0 33 34                     # v5 P
concat 1 2                        # v6

slice 0 9 27                      # v6 = words 8..25
concat 5 6                        # v7
slice 4 8 9                       # v8 = BP'
concat 7 8                        # v9 (26)
slice 0 28 35                     # v10 = words 27..33
concat 9 10                       # v11
dense 1 1 1                       # v12 = 0 (SUB)
   0
   0
concat 11 12                      # v13 (34)
slice 0 36 65                     # v14 = words 35..63
concat 13 14                      # v15

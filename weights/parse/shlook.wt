   0 1 0
   0 0 1
   0 0 1
   -96.5 -122.5 -96.5 -122.5 -96.5 -122.5
step 27                           # v28
concat 1 28                       # v29 = [x0, 6 thresholds]
dense 29 1 7                      # v30 = HWv = x0 - 32 L0 - 2^21 L1 - 2^37 L2 (fold a..z)
   1 -32 32 -2097152 2097152 -137438953472 137438953472
   0
dense 2 8 1                       # v31 = PC - k + 0.5
   1
   1
   1
   1
   1

# parse/shlook (id 122): find the sheet whose name equals the packed, case-folded key at 0x27F0 (from
# shpack, length N in X2), emit token [8, SHEET] at OUTP and continue in lword at char I (after '!').
# X0 s, X1 CNT, X2 N, X3 h (name handle), X4 w (word index), X5 HW (folded heap word).
# PC 0 read SHEET_COUNT (0x0F) | 1, 2 s >= CNT -> reject, else read SHEET_TABLE + 16 s (name handle)
# | 3 h = x0, read [h] (length) | 4 length != N -> s + 1, PC 2; else read [h + 2] | 5 HW = fold(x0),
# read [0x27F0 + w] | 6 x0 != HW -> s + 1, PC 2; equal and 3 (w + 1) < N -> w + 1, read [h + 3 + w];
# equal and done -> write 8 at OUTP | 7 write s at OUTP + 1, OUTP += 2, NT += 1 | 8 read char I ->
# lword with RDOK 1, KEY 0, KLEN 100, other lword registers 0, TV = -1. Note: weights/parse/shlook.md
input 65
slice 0 0 1                       # v1 = [x0]
slice 0 8 9                       # v2 = [PC]
slice 0 57 63                     # v3 = [s CNT N h w HW]
slice 0 30 31                     # v4 = [I]
slice 0 38 40                     # v5 = [OUTP NT]
slice 0 13 14                     # v6 = [STATUS]
slice 0 55 56                     # v7 = [TV]
dense 1 1 1                       # v8 = y = x0 2^-16 (UNPACK3, exact scaling)
   0.0000152587890625
   0
dense 8 1 1                       # v9
   1
   6755399441055744
dense 9 1 1                       # v10 = r = round(y)
   1
   -6755399441055744
concat 10 8                       # v11 = [r y]
dense 11 1 2                      # v12 = r - y
   1 -1
   0
step 12                           # v13
concat 11 13                      # v14 = [r y g]
dense 14 1 3                      # v15 = f = floor(x0 / 2^16)
   1 0 -1
   0
dense 15 1 1                      # v16 = y2 = f 2^-16
   0.0000152587890625
   0
dense 16 1 1                      # v17
   1
   6755399441055744
dense 17 1 1                      # v18 = r2
   1
   -6755399441055744
concat 18 16                      # v19 = [r2 y2]
dense 19 1 2                      # v20
   1 -1
   0
step 20                           # v21
concat 19 21                      # v22
dense 22 1 3                      # v23 = c2 = floor(f / 2^16)
   1 0 -1
   0
concat 1 15                       # v24 = [x0 f]
concat 24 23                      # v25 = [x0 f c2]
dense 25 3 3                      # v26 = [c0 c1 c2]
   1 -65536 0
   0 1 -65536
   0 0 1
   0 0 0
dense 26 6 3                      # v27 = lower-case thresholds per unit
   1 0 0
   1 0 0

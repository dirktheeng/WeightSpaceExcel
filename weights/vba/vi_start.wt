  0
  3735552 3801088 3801088
slice 0 44 45                     # v5 word 43 VHT
dense 1 3 1                       # v6 [DOUT, MOUT, ERR]
  0
  0
  0
  3784704 3792896 0
slice 0 48 65                     # v7 words 47..63
concat 2 3
concat 8 4
concat 9 5
concat 10 6
concat 11 7

# kernel/c_top (id 11): commit step 3. HEAP_TOP (0x01) = L8 + [L7 > 0] (end of the packed words); next 12.
# Note: weights/kernel/commit.md
input 65
slice 0 48 50                     # v1 = [pos, waddr] = L7, L8
dense 1 1 2                       # v2 = pos - 0.5
   1 0
   -0.5
step 2                            # v3 = g = [pos > 0]
concat 1 3                        # v4 = [pos, waddr, g]
dense 4 7 3                       # v5 = words 0..6
   0 0 0                          # next (bias 12)
   0 0 0                          # mem_op (bias 2)
   0 0 0                          # addr (bias 1 = HEAP_TOP)
   0 1 1                          # value = waddr + g
   0 0 0
   0 0 0
   0 0 0
# biases
   12 2 1 0 0 0 0
slice 0 8 65                      # v6 = words 7..63 pass
concat 5 6                        # v7 = output

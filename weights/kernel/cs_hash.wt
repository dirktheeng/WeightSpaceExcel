# kernel/cs_hash (id 16): CELL_GET / CELL_SET entry. Hash (AS, AR1, AC1) to slot address P0,
# packed key + 1 into T0, read the slot key word. next = cs_probe (17). T1 (mode) passes.
# Note: weights/kernel/cs_hash.md
input 65
slice 0 20 23                     # v1 = [S, R, C] = words 19, 20, 21
dense 1 1 3                       # v2 = t = 1000003 S + 40503 R + 65599 C  (R4 exact)
  1000003 40503 65599
  0
dense 2 1 1                       # v3 = q = t * 2^-16 (R1, exact power of two)
  0.0000152587890625
  0
dense 3 1 1                       # v4 = q + C
  1
  6755399441055744
dense 4 1 1                       # v5 = r = round(q)
  1
  -6755399441055744
concat 5 2                        # v6 = [r, t]
dense 6 1 2                       # v7 = 65536 r - t (positive iff r rounded up)
  65536 -1
  0
step 7                            # v8 = g
concat 6 8                        # v9 = [r, t, g]
concat 9 1                        # v10 = [r, t, g, S, R, C]
dense 10 9 6                      # v11 = words 0..6, P0, T0
#  r  t   g   S            R      C
   0  0   0   0            0      0     # next (bias 17 = cs_probe)
   0  0   0   0            0      0     # mem_op (bias 1 = read)
  -524288  8  524288  0     0      0     # addr = 0x10000 + 8 (t - 65536 floor(q)) = 0x10000 + 8 slot
   0  0   0   0            0      0     # value
   0  0   0   0            0      0     # io
   0  0   0   0            0      0     # io_arg
   0  0   0   0            0      0     # halt
  -524288  8  524288  0     0      0     # P0 = slot base address (same as addr)
   0  0   0   17179869184  16384  1     # T0 = S 2^34 + R 2^14 + C (+1 by bias) = K + 1
# biases
  17 1 65536 0 0 0 0 65536 1
slice 11 0 7                      # v12 = words 0..6
slice 0 8 26                      # v13 = words 7..24 pass
slice 11 7 8                      # v14 = P0 (word 25)
slice 0 27 30                     # v15 = words 26..28 pass
slice 11 8 9                      # v16 = T0 (word 29)
slice 0 31 65                     # v17 = words 30..63 pass (T1 included)
concat 12 13                      # v18
concat 18 14                      # v19
concat 19 15                      # v20
concat 20 16                      # v21
concat 21 17                      # v22 = output

# ui/prod (id 149): produce the display text of value A into BUF, then return to L17.
# TAG 1 number -> fnum (131); 2 text -> hcopy (133, T0 = handle); 3 boolean -> str (130,
# TRUE 108 / FALSE 113); 4 error -> str (offset by error code); anything else -> go to L18.
# Note: weights/ui/cells.md.  M = 2^20 = 1048576
input 65
slice 0 14 16                     # v1 = [tag pay]
slice 0 58 60                     # v2 = [L17 L18]
concat 1 2                        # v3 = [tag pay L17 L18]
dense 3 20 4                      # v4 = tag thermometer m 1..5, pay thermometer m 1..15
